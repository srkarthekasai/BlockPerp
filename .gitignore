@'
# Dependencies and generated frontend files
node_modules/
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Environment variables and secrets
.env
.env.*
!.env.example

# Foundry build artifacts
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Local IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
'@ | Set-Content -Path ".gitignore" -Encoding utf8